<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos base (instalación) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Temporizador de enfoque (PL-13): Android 14+ exige declarar un tipo para todo servicio en primer
         plano y ninguno de los tipos específicos encaja con un temporizador. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Lint lo marca como ProtectedPermissions por datos desactualizados de su base de permisos;
         SCHEDULE_EXACT_ALARM es un permiso especial que el usuario habilita en Ajustes, no de firma. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Permisos en ejecución (se piden en contexto) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- La cámara es opcional (CameraX + ML Kit, fase 3): sin esto, Play/ChromeOS asumen que es obligatoria -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Accesos especiales (se habilitan en Ajustes del sistema) -->
    <!-- Notificaciones, alarmas exactas, pantalla completa, uso de datos, acceso a notificaciones -->

    <application
        android:name=".StayFocusedApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StayFocused"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StayFocused"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receptor de arranque para reprogramar alarmas -->
        <receiver
            android:name=".core.notifications.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Pantalla completa de una alarma sonora (PL-11): se muestra sobre el bloqueo y enciende la
             pantalla. No se exporta ni aparece en recientes: solo la abre la notificación.
             showWhenLocked/turnScreenOn existen desde Android 8.1 (API 27); antes se ignoran y la
             alarma igual suena como notificación. -->
        <activity
            android:name=".planner.ui.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.StayFocused"
            tools:targetApi="o_mr1" />

        <!-- Recibe la alarma de un recordatorio y los botones Completar/Posponer de su notificación.
             No se exporta: solo la propia app (AlarmManager y la notificación) lo invoca. -->
        <receiver
            android:name=".planner.data.ReminderReceiver"
            android:exported="false" />

        <!-- Temporizador de enfoque (PL-13). El servicio mantiene viva la app mientras corre y muestra la
             notificación persistente; el receptor recibe la alarma de fin y los botones de esa notificación.
             Ninguno se exporta: solo la propia app los invoca. -->
        <service
            android:name=".planner.data.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus_timer" />
        </service>
        <receiver
            android:name=".planner.data.FocusTimerReceiver"
            android:exported="false" />

    </application>

</manifest>